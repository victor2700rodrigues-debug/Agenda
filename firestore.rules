rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dados de cada conta: só o dono, com e-mail confirmado.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    // Perfil de cada conta (e-mail, último acesso, contagens).
    // O dono grava o próprio; só o administrador lê todos.
    match /perfis/{uid} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
      allow read: if request.auth != null
        && (request.auth.uid == uid
          || (request.auth.token.email == "victor2700rodrigues@gmail.com"
            && request.auth.token.email_verified == true));
    }
  }
}
